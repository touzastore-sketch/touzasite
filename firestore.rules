rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: allow user and admin operations
    match /users/{userId} {
      allow read, write: if true;

      match /orders/{orderId} {
        allow read, write: if true;
      }
    }

    // Top-level orders collection: allow order creation and admin dashboard reading
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Collection group rule for orders (enables admin collectionGroup query across all users)
    match /{path=**}/orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Categories collection: public read, write allowed for boutique store management
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Reviews collection: public read, write tied to user or admin operations
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Products collection: public read, write for store admin
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Promo codes collection: public read, write for store admin
    match /promoCodes/{promoId} {
      allow read: if true;
      allow write: if true;
    }

    // Store settings collections: public read, write for store admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /storeSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Subscribers, Deleted Subscribers & Newsletter Campaigns collections
    match /subscribers/{subscriberId} {
      allow read, write: if true;
    }

    match /deleted_subscribers/{deletedId} {
      allow read, write: if true;
    }

    match /newsletterCampaigns/{campaignId} {
      allow read, write: if true;
    }
  }
}
